#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
case "$(uname -s)" in Darwin) os=darwin;; Linux) os=linux;; MINGW*|MSYS*|CYGWIN*) os=windows;; *) echo 'VCS: unsupported operating system' >&2; exit 1;; esac
case "$(uname -m)" in arm64|aarch64) arch=arm64;; x86_64|amd64) arch=amd64;; *) echo 'VCS: unsupported CPU architecture' >&2; exit 1;; esac
name="vcs_${os}_${arch}"
[ "$os" != windows ] || name="$name.exe"
exe="$root/bin/$name"
[ -x "$exe" ] || { echo "VCS plugin incomplete: bundled binary $name is missing. Reinstall the vcs plugin from the marketplace." >&2; exit 1; }
# The binaries ship inside the plugin, so verify them against the checksum list built with the package.
sums="$root/bin/SHA256SUMS"
if [ -f "$sums" ]; then
 if command -v sha256sum >/dev/null 2>&1; then actual=$(sha256sum "$exe" | cut -d' ' -f1)
 elif command -v shasum >/dev/null 2>&1; then actual=$(shasum -a 256 "$exe" | cut -d' ' -f1)
 else actual=; fi
 if [ -n "$actual" ]; then
  expected=$(grep " $name\$" "$sums" | cut -d' ' -f1 || true)
  [ "$actual" = "$expected" ] || { echo "VCS plugin binary $name failed its checksum. Reinstall the vcs plugin from the marketplace." >&2; exit 1; }
 fi
fi
exec "$exe" "$@"
