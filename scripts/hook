#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
case "$(uname -s)" in Darwin) os=darwin;; Linux) os=linux;; MINGW*|MSYS*|CYGWIN*) os=windows;; *) echo 'VCS hook: unsupported OS' >&2; exit 1;; esac
case "$(uname -m)" in arm64|aarch64) arch=arm64;; x86_64|amd64) arch=amd64;; *) echo 'VCS hook: unsupported architecture' >&2; exit 1;; esac
exe="$root/libexec/vcs-hook_${os}_${arch}"
[ "$os" != windows ] || exe="$exe.exe"
[ -x "$exe" ] || { echo 'VCS plugin incomplete: bundled hook missing; reinstall marketplace plugin' >&2; exit 1; }
exec "$exe"
